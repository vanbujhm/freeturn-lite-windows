diff --git a/docs/flags.md b/docs/flags.md
index dd50f06..0aa8fd7 100644
--- a/docs/flags.md
+++ b/docs/flags.md
@@ -20,6 +20,7 @@
 | `-obf-timing`       | `0`                                               | межпакетная задержка для RTP-мимикрии (напр. `20ms`); только с `-obf-profile != none`; `0` = выкл. В `-mode tcp` особенно уместна: KCP гонит бёрсты полноразмерных пакетов, без выравнивания профиль на Opus не похож                                     |
 | `-gen-obf-key`      | `false`                                           | напечатать новый ключ и выйти                                                                                                                                                                                                                             |
 | `-manual-captcha`   | `false`                                           | сразу ручной режим captcha (только `-provider vk`)                                                                                                                                                                                                        |
+| `-advanced-captcha` | `false`                                           | авто captcha берёт PoW из настоящего браузера (страница открывается в системном браузере); если не вышло, обычное авто. С `-manual-captcha` не действует (только `-provider vk`)                                                                          |
 | `-streams-per-cred` | `12`                                              | потоков на один кеш учёток (только `-provider vk`)                                                                                                                                                                                                     |
 | `-platform`         | `desktop`                                         | класс устройства персоны авторизации (мобильность UA/device/client hints): `desktop` \| `mobile` (только `-provider vk`)                                                                                                                                      |
 | `-dns-mode`         | `auto`                                            | `plain` (UDP/53) \| `doh` \| `auto`                                                                                                                                                                                                                       |
diff --git a/internal/config/args.go b/internal/config/args.go
index 4ac35d7..d007cc9 100644
--- a/internal/config/args.go
+++ b/internal/config/args.go
@@ -36,6 +36,7 @@ func ClientArgs(c *Client) []string {
 	addIf(c.Obf.Enabled(), "-obf-key", hex.EncodeToString(c.Obf.Key))
 	addIf(c.Obf.Timing > 0, "-obf-timing", c.Obf.Timing.String())
 	addIf(c.VK.ManualCaptcha, "-manual-captcha")
+	addIf(c.VK.AdvancedCaptcha, "-advanced-captcha")
 	addIf(c.VK.Platform != def.VK.Platform, "-platform", string(c.VK.Platform))
 	addIf(c.DNS.Mode != def.DNS.Mode, "-dns-mode", c.DNS.Mode)
 	addIf(len(c.DNS.Servers) > 0, "-dns-servers", strings.Join(c.DNS.Servers, ","))
